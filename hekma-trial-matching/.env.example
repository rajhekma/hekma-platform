# Copy to .env locally. On dev K8s, DevOps sets these as pod secrets/env (never commit .env).

# CORS (browser Trial Match UI). Default: localhost + any https?://*.hekma.ai subdomain.
# CORS_ALLOW_HEKMA_SUBDOMAINS=false
# CORS_ORIGIN_REGEX=^https?://([a-zA-Z0-9-]+\.)*hekma\.ai(?::\d+)?$
# CORS_EXTRA_ORIGINS=https://partner.example.com,http://localhost:8080

# PostgreSQL (REQUIRED — app crashes on startup if any of PG_* below are missing)
# App tables (compose, jobs, patients). trialgpt_corpus uses CORPUS_PG_* below.
PG_HOST=
PG_PORT=5432
PG_DB=hekmaai
PG_USER=
PG_PASSWORD=

# public.trialgpt_corpus. When CORPUS_PG_HOST is unset, corpus queries use PG_*.
CORPUS_PG_HOST=
CORPUS_PG_PORT=5432
CORPUS_PG_DB=trails
CORPUS_PG_USER=
CORPUS_PG_PASSWORD=
PG_POOL_MIN=1
PG_POOL_MAX=10
# Full trialgpt_corpus export needs >5s default on large tables
PG_STATEMENT_TIMEOUT_MS=120000

# MySQL (optional — API falls back to utils/mysql_util.py if unset)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# LLM providers (both required for P2T/T2P + Qdrant embeddings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# JWT (API auth)
JWT_SECRET=
JWT_ALGORITHM=HS512
JWT_HEADER_PREFIX=Token

# Internal service-to-service (lambda → gpt-api trial_gpt_ehr ingest)
TRIALGPT_EHR_INGEST_API_KEY=Uy55m934n4YQyZ8q+3g6rQF1JxZl+2H5vZrYQ0+8y6b5rZ9k7D9F6QxWcN2xYc=

# Qdrant (RAG retrieval)
QDRANT_HOST=31.70.106.173
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_PATIENT_COLLECTION=patient_profiles_hybrid_v1
QDRANT_TRIAL_COLLECTION=clinical_trials_hybrid_v1

# QA only, one-shot: copy trialgpt_corpus from Dev PG on first boot.
# Never runs from request handlers. Skips if already seeded (DB marker)
# or local COUNT(*) == TRIALGPT_CORPUS_SEED_EXPECTED_ROWS (2508).
# Leave false on prod. Requires DEV_PG_* secrets in the QA pod.
TRIALGPT_CORPUS_SEED_FROM_DEV=false
TRIALGPT_CORPUS_SEED_EXPECTED_ROWS=2508
TRIALGPT_CORPUS_SEED_REQUIRED=false
DEV_PG_HOST=
DEV_PG_PORT=5432
DEV_PG_DB=hekmaai
DEV_PG_USER=
DEV_PG_PASSWORD=

# Auto-ingest on API startup (no manual DevOps scripts)
QDRANT_AUTO_INGEST_ON_STARTUP=true
QDRANT_INGEST_BATCH_SIZE=50
QDRANT_INGEST_RECREATE=false
QDRANT_TRIALS_FROM_POSTGRES=true
QDRANT_TRIALS_CORPUS_PATH=dataset/trials.jsonl
QDRANT_INGEST_ADMIN_SECRET=
QDRANT_INGEST_SKIP_QUERY_EXPANSION=true

# Patient AI cost analytics (hekma-platform commerce)
AI_USAGE_ENABLED=true
AI_USAGE_INGEST_URL=http://localhost:8090/internal/v1/ai-usage/events
# AI_USAGE_SQS_QUEUE_URL=
# AI_COST_API_KEY=
