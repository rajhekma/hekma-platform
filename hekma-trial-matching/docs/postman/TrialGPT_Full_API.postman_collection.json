{
  "info": {
    "_postman_id": "trialgpt-full-api-v2",
    "name": "TrialGPT — Full API Collection",
    "description": "Complete TrialGPT API collection (all implemented endpoints as of trialgpt-api-v2).\n\n**Variables:** Set `baseUrl`, `jwtToken`, and optional IDs in collection or environment.\n\n**Auth:** Most routes need `Authorization: Token {{jwtToken}}` and `logged-in-user-type: {{loggedInUserType}}`.\n\n**Patient IDs:** Use MySQL numeric `patientId` (e.g. 203450) for P2T APIs; use `subjectId` (UUID) for T2P patient-inference when returned from job results.\n\n**Caching (P2T & T2P):** `/start` returns a cached COMPLETED job when an identical request (same parameters) has already finished. The response includes `\"cached\": true` and the existing `job_id` — no retrieval or LLM calls are re-run. Send `\"force_rerun\": true` to bypass the cache and force a fresh run (e.g. after trial/patient data changes). Changing any parameter (e.g. `prospective_patient_count`) also produces a new run.\n\n**Concurrency:** LLM matching/aggregation run in parallel; tune server-side with env `TRIALGPT_LLM_WORKERS` (default 4).\n\n**Default port:** `baseUrl` points at `http://127.0.0.1:8001` (local dev server).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8001", "type": "string" },
    { "key": "jwtToken", "value": "", "type": "string" },
    { "key": "jwtHeaderPrefix", "value": "Token", "type": "string" },
    { "key": "loggedInUserType", "value": "Site", "type": "string" },
    { "key": "ingestSecret", "value": "change-me-in-dev-secrets", "type": "string" },
    { "key": "jobId", "value": "", "type": "string" },
    { "key": "patientId", "value": "203450", "type": "string" },
    { "key": "subjectId", "value": "00c13f8d-c0c1-55f2-b2d5-eab8ea4fdae2", "type": "string" },
    { "key": "nctId", "value": "NCT01771861", "type": "string" },
    { "key": "siteId", "value": "site-dev-001", "type": "string" },
    { "key": "disease", "value": "Trauma", "type": "string" },
    { "key": "annotationPatientId", "value": "00bf0672-1125-5fee-b375-838a4e4628a1", "type": "string" },
    { "key": "prospectivePatientCount", "value": "20", "type": "string" }
  ],
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 — Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Public health check. Returns `{\"status\":\"ok\"}` when API is up."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 — Qdrant Admin",
      "item": [
        {
          "name": "GET /api/admin/qdrant/status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Qdrant-Ingest-Secret", "value": "{{ingestSecret}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/admin/qdrant/status",
            "description": "Qdrant ingest status + patient/trial point counts. Requires QDRANT_INGEST_ADMIN_SECRET on server."
          },
          "response": []
        },
        {
          "name": "POST /api/admin/qdrant/ingest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Qdrant-Ingest-Secret", "value": "{{ingestSecret}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/admin/qdrant/ingest",
            "description": "Trigger patient + trial Qdrant ingest (skips if collections populated)."
          },
          "response": []
        },
        {
          "name": "POST /api/admin/qdrant/ingest?force=true",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Qdrant-Ingest-Secret", "value": "{{ingestSecret}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/qdrant/ingest?force=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "qdrant", "ingest"],
              "query": [{ "key": "force", "value": "true" }]
            },
            "description": "Force re-ingest (recreate / repopulate collections)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 — P2T (Patient → Trials)",
      "item": [
        {
          "name": "POST /api/patient-to-trials/start",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.job_id) pm.collectionVariables.set('jobId', j.job_id);",
                  "  const cached = j.cached === true || j.status === 'COMPLETED';",
                  "  console.log('job_id=' + j.job_id + ' status=' + j.status + ' cached=' + !!j.cached);",
                  "  pm.test('start accepted (STARTED or cached COMPLETED)', function () {",
                  "    pm.expect(['STARTED', 'COMPLETED']).to.include(j.status);",
                  "  });",
                  "  if (cached) { console.log('Cache hit — skipping retrieval + LLM. Fetch results directly via GET /api/jobs/{{jobId}}/results'); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{patientId}}\",\n  \"selected_disease\": [\"{{disease}}\"],\n  \"selected_region\": [\"US\"],\n  \"corpus\": \"sigir\",\n  \"retrieval_mode\": \"rag\",\n  \"llm_service\": \"claude\",\n  \"model\": \"claude-sonnet-4-6\",\n  \"force_rerun\": true,\n  \"debug\": true\n}"
            },
            "url": "{{baseUrl}}/api/patient-to-trials/start",
            "description": "Start Patient-to-Trials job. `patient_id` = MySQL numeric ID (not UUID).\n\n**Caching:** With `force_rerun: false`, an identical prior COMPLETED job is returned immediately (`\"cached\": true`) — no retrieval or LLM calls. This example uses `force_rerun: true` to always run fresh; set it to `false` to use the cache.\n\n**Response:** `{ job_id, flow_type: \"P2T\", status: \"STARTED\" | \"COMPLETED\", cached: bool }`."
          },
          "response": []
        },
        {
          "name": "GET /api/jobs/{job_id}/status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/jobs/{{jobId}}/status",
            "description": "Poll job until status is COMPLETED or FAILED."
          },
          "response": []
        },
        {
          "name": "GET /api/jobs/{job_id}/results",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/jobs/{{jobId}}/results",
            "description": "Ranked trial evaluations for a completed P2T job."
          },
          "response": []
        },
        {
          "name": "GET /api/jobs/{job_id}/nct-inference",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}/nct-inference?nct_id={{nctId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "{{jobId}}", "nct-inference"],
              "query": [{ "key": "nct_id", "value": "{{nctId}}" }]
            },
            "description": "Per-criterion inference for one NCT in a P2T job."
          },
          "response": []
        },
        {
          "name": "GET /api/jobs?patient_id=",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs?patient_id={{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"],
              "query": [{ "key": "patient_id", "value": "{{patientId}}" }]
            },
            "description": "List P2T jobs for a patient (MySQL patient_id)."
          },
          "response": []
        },
        {
          "name": "GET /api/patient/{patient_id}/diseases",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/patient/{{patientId}}/diseases",
            "description": "Patient diseases with ICD-10 and UI labels."
          },
          "response": []
        },
        {
          "name": "GET /api/patient/{patient_id}/summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/patient/{{patientId}}/summary",
            "description": "Compose block summary for patient."
          },
          "response": []
        },
        {
          "name": "GET /api/patient/{patient_id}/jobs-with-results",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/patient/{{patientId}}/jobs-with-results",
            "description": "All P2T jobs for patient; includes full results for COMPLETED jobs."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 — T2P (Trial → Patients)",
      "item": [
        {
          "name": "POST /api/trial-to-patients/start",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.job_id) pm.collectionVariables.set('jobId', j.job_id);",
                  "  const cached = j.cached === true || j.status === 'COMPLETED';",
                  "  console.log('job_id=' + j.job_id + ' status=' + j.status + ' cached=' + !!j.cached);",
                  "  pm.test('start accepted (STARTED or cached COMPLETED)', function () {",
                  "    pm.expect(['STARTED', 'COMPLETED']).to.include(j.status);",
                  "  });",
                  "  if (cached) { console.log('Cache hit — skipping retrieval + LLM. Fetch results directly via GET /api/jobs/{{jobId}}/results'); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nct_id\": \"{{nctId}}\",\n  \"site_id\": \"{{siteId}}\",\n  \"prospective_patient_count\": {{prospectivePatientCount}},\n  \"corpus\": \"sigir\",\n  \"retrieval_mode\": \"rag\",\n  \"llm_service\": \"claude\",\n  \"model\": \"claude-sonnet-4-6\",\n  \"force_rerun\": false,\n  \"debug\": true\n}"
            },
            "url": "{{baseUrl}}/api/trial-to-patients/start",
            "description": "Start Trial-to-Patients job.\n\n**Caching:** With `force_rerun: false`, an identical prior COMPLETED job is returned immediately (`\"cached\": true`) — no retrieval or LLM calls. Set `force_rerun: true` to force a fresh run.\n\n**Response:** `{ job_id, flow_type: \"T2P\", status: \"STARTED\" | \"COMPLETED\", cached: bool }`. Poll `GET /api/jobs/{{jobId}}/status` until `COMPLETED`/`FAILED`, then `GET /api/jobs/{{jobId}}/results`.\n\n**`prospective_patient_count`** = number of candidate patients retrieved from Qdrant and evaluated by the LLM."
          },
          "response": []
        },
        {
          "name": "GET /api/jobs/{job_id}/status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/jobs/{{jobId}}/status",
            "description": "Poll T2P job until status is COMPLETED or FAILED. On failure the job now reports a terminal FAILED state with `error` and `error_stage` populated (retrieval no longer hangs in RUNNING). Stage fields: compose_status, retrieve_status, evaluate_status, rank_status."
          },
          "response": []
        },
        {
          "name": "GET /api/jobs/{job_id}/results",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/jobs/{{jobId}}/results",
            "description": "Ranked patient evaluations for a completed T2P job."
          },
          "response": []
        },
        {
          "name": "GET /api/jobs/{job_id}/patient-inference",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}/patient-inference?patient_id={{subjectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "{{jobId}}", "patient-inference"],
              "query": [{ "key": "patient_id", "value": "{{subjectId}}" }]
            },
            "description": "Per-criterion inference for one patient in a T2P job. `patient_id` can be MySQL ID or subject UUID."
          },
          "response": []
        },
        {
          "name": "GET /api/jobs?nct_id=",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{jwtHeaderPrefix}} {{jwtToken}}", "type": "text" },
              { "key": "logged-in-user-type", "value": "{{loggedInUserType}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs?nct_id={{nctId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"],
              "query": [{ "key": "nct_id", "value": "{{nctId}}" }]
            },
            "description": "List T2P jobs for an NCT ID."
          },
          "response": []
        }
      ]
    },
