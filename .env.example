# Copy to .env for docker-compose (optional overrides)

# PostgreSQL (platform / clinical services)
POSTGRES_USER=hekma
POSTGRES_PASSWORD=hekma_local_dev
POSTGRES_DB=hekma_platform
POSTGRES_PORT=5433

# MySQL (CTMS / Java monolith)
MYSQL_ROOT_PASSWORD=hekma_root
MYSQL_DATABASE=operations_hekma
MYSQL_USER=hekma
MYSQL_PASSWORD=hekma_local_dev
MYSQL_PORT=3307

# Redis
REDIS_PORT=6379

# API Gateway
GATEWAY_PORT=9080

# Patient Health
PATIENT_HEALTH_PORT=8010
JWT_SECRET=local-dev-only-change-me

# Clinical AI (scanner + EHR summary)
SCANNER_PORT=8011
OPENAI_API_KEY=

# Commerce (AI cost analytics)
COMMERCE_PORT=8090
# AI_COST_API_KEY=

# Monolith URLs (host machine — for nginx proxy)
PYTHON_MONOLITH_URL=http://host.docker.internal:8000
JAVA_MONOLITH_URL=http://host.docker.internal:8080

# LocalStack
LOCALSTACK_PORT=4566
AWS_DEFAULT_REGION=us-east-1

# Example connection strings for app .env files
# DATABASE_URL=postgresql://hekma:hekma_local_dev@localhost:5433/hekma_platform
# MYSQL_URL=mysql://hekma:hekma_local_dev@localhost:3307/operations_hekma
# REDIS_URL=redis://localhost:6379/0
