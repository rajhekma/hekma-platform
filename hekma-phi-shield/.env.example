# Privacy Detection Service Environment
CUSTOM_DOMAIN=https://pii-phi.hekma.ai
SERVICE_PORT=8080
SERVICE_HOST=0.0.0.0

# Storage Backend: postgresql | json | memory
STORAGE_BACKEND=postgresql
DATABASE_URL=postgresql+asyncpg://hekma:hekma_local_dev@localhost:5433/hekma_platform
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# PHI Clinical Detector
PHI_DETECTOR_BACKEND=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_PHI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45.0