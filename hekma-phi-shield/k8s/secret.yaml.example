apiVersion: v1
kind: Secret
metadata:
  name: privacy-detection-secrets
  namespace: privacy-detection
type: Opaque
stringData:
  DATABASE_URL: "postgresql+asyncpg://USER:PASSWORD@HOST:5432/hekmaai"
  OPENAI_API_KEY: "REPLACE_ME"
  ENCRYPTION_KEY: "REPLACE_WITH_32_BYTE_BASE64_KEY"
  HMAC_SECRET: "REPLACE_ME"
  SERVICE_API_KEY: "REPLACE_ME"
  ADMIN_API_KEY: "REPLACE_ME"
