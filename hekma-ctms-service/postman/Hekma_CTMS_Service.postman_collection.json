    {
      "name": "EDC Webhooks",
      "item": [
        {
          "name": "1. Generate EDC Webhook Keys",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{ctms_base_url}}/webhook/cmts/generate-keys?studyId={{study_id}}&siteId={{site_id}}&createdBy=admin",
              "host": [
                "{{ctms_base_url}}"
              ],
              "path": [
                "webhook",
                "cmts",
                "generate-keys"
              ],
              "query": [
                {
                  "key": "studyId",
                  "value": "{{study_id}}"
                },
                {
                  "key": "siteId",
                  "value": "{{site_id}}"
                },
                {
                  "key": "createdBy",
                  "value": "admin"
                }
              ]
            },
            "description": "Generates access key and secret key for external EDC ingestion."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "    if (jsonData.data.accessKey) pm.environment.set(\"edc_access_key\", jsonData.data.accessKey);",
                  "    if (jsonData.data.secretKey) pm.environment.set(\"edc_secret_key\", jsonData.data.secretKey);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Ingest EDC Webhook Payload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Access-Key",
                "value": "{{edc_access_key}}",
                "type": "text"
              },
              {
                "key": "X-Secret-Key",
                "value": "{{edc_secret_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{ctms_base_url}}/webhook/cmts",
              "host": [
                "{{ctms_base_url}}"
              ],
              "path": [
