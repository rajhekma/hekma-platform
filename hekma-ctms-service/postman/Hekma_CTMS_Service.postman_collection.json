  },
  "item": [
    {
      "name": "Clinical Studies",
      "item": [
        {
          "name": "1. Create Study Protocol",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{ctms_base_url}}/api/v1/studies",
              "host": [
                "{{ctms_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "studies"
              ],
              "query": []
            },
            "description": "Creates a clinical study protocol under the caller's tenant subtree.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studyNumber\": \"ST-2026-001\",\n  \"protocolNumber\": \"PROTO-ONC-01\",\n  \"studyTitle\": \"Phase III Oncology Targeted Therapy\",\n  \"nameOfImp\": \"HKM-2026\",\n  \"devPhase\": \"Phase 3\",\n  \"primaryEndPoint\": \"Overall Survival (OS) at 24 months\",\n  \"secondaryEndPoint\": \"Progression-Free Survival (PFS)\",\n  \"startDate\": \"2026-11-01\",\n  \"endDate\": \"2028-11-01\",\n  \"studyStatus\": \"ACTIVE\",\n  \"studyType\": \"INTERVENTIONAL\",\n  \"indication\": \"Advanced Solid Tumors\",\n  \"therapeuticArea\": \"Oncology\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.studyId) {",
                  "    pm.environment.set(\"study_id\", jsonData.data.studyId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
