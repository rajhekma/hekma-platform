              ],
              "path": [
                "api",
                "v1",
                "auth",
                "reset-password"
              ],
              "query": []
            },
            "description": "Verifies OTP attempt and sets a new password in Firebase Auth.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attemptId\": \"{{otp_attempt_id}}\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NewPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "7. Change Password (Authenticated)",
          "request": {
            "method": "POST",
            "header": [
