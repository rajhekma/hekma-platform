              "query": []
            },
            "description": "Authenticated password rotation. Revokes active sessions and returns refreshed tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"UpdatedPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
