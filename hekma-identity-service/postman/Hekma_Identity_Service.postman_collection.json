        },
        {
          "name": "2. Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{identity_base_url}}/api/v1/auth/otp/verify",
              "host": [
                "{{identity_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "otp",
                "verify"
              ],
              "query": []
            },
            "description": "Verifies OTP code and activates account if PENDING_VERIFICATION. Sets auth_token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attemptId\": \"{{otp_attempt_id}}\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.idToken) {",
                  "    pm.environment.set(\"auth_token\", jsonData.idToken);",
                  "    console.log(\"Captured auth_token from OTP verification:\", jsonData.idToken);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.environment.set(\"user_id\", jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Resend OTP",
