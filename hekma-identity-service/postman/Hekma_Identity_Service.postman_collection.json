{
  "info": {
    "name": "Hekma Identity Service API",
    "description": "Authentication, Multi-tenancy, User management, RBAC Phase 3, Patient onboarding, and GraphQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Register Patient (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{identity_base_url}}/api/v1/auth/register",
              "host": [
                "{{identity_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ],
              "query": []
            },
            "description": "Creates a user account in Firebase Auth, persists profile in PostgreSQL with PENDING_VERIFICATION, and dispatches OTP.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.test@hekma.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"password\": \"Password123!\",\n  \"displayName\": \"Test Patient\",\n  \"role\": \"PATIENT\",\n  \"verificationMode\": \"EMAIL\",\n  \"invitationCode\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.attemptId) {",
                  "    pm.environment.set(\"otp_attempt_id\", jsonData.attemptId);",
                  "    console.log(\"Captured otp_attempt_id:\", jsonData.attemptId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Register Tenant & Owner (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{identity_base_url}}/api/v1/auth/register-tenant",
              "host": [
                "{{identity_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register-tenant"
              ],
              "query": []
            },
            "description": "Self-registers an organization tenant and root owner in PENDING_VERIFICATION status.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantName\": \"Mayo Clinic Trials\",\n  \"tenantSlug\": \"mayo-clinic-trials\",\n  \"tenantType\": \"SITE\",\n  \"ownerEmail\": \"investigator@mayo.edu\",\n  \"ownerPhoneNumber\": \"+1987654321\",\n  \"ownerPassword\": \"Password123!\",\n  \"ownerDisplayName\": \"Dr. Investigator\",\n  \"verificationMode\": \"EMAIL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.attemptId) {",
                  "    pm.environment.set(\"otp_attempt_id\", jsonData.attemptId);",
                  "    console.log(\"Captured otp_attempt_id:\", jsonData.attemptId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Login (Direct / 2FA Trigger)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{identity_base_url}}/api/v1/auth/login",
              "host": [
                "{{identity_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ],
              "query": []
            },
            "description": "Authenticates credentials against Firebase. For patients with 2FA, triggers OTP. Saves auth_token to environment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hekma.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.idToken) {",
                  "    pm.environment.set(\"auth_token\", jsonData.idToken);",
                  "    console.log(\"Captured auth_token:\", jsonData.idToken);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.environment.set(\"refresh_token\", jsonData.refreshToken);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.environment.set(\"user_id\", jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Refresh ID Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{identity_base_url}}/api/v1/auth/refresh-token",
              "host": [
                "{{identity_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh-token"
              ],
              "query": []
            },
            "description": "Exchanges Firebase refresh token for a fresh ID token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
