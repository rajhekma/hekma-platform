              "query": []
            },
            "description": "Dispatches 6-digit OTP code to email or phone.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"patient.test@hekma.com\",\n  \"mode\": \"EMAIL\",\n  \"purpose\": \"REGISTRATION\"\n}",
              "options": {
